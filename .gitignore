# ==============================================================================
# Git Ignore Rules: Dual-Stack PHP & Java JSP Web Platform
# ==============================================================================

# Configurações locais sensíveis (credenciais de conexão à BD)
php/basedados/ligabd.local.php
.env
.env.local

# Ficheiros compilados e artefactos Java / Tomcat
*.class
*.war
*.ear
*.jar
target/
build/
.metadata/
.settings/
.project
.classpath
.gradle/

# Ficheiros temporários e logs do PHP / Apache / Tomcat
*.log
error_log
access_log
error_log.txt
catalina.out
localhost.*.log

# Backups e ficheiros temporários do MySQL
*.sql.bak
*.sql.old
*.dump

# Ficheiros de Upload temporários
uploads/tmp/*
!uploads/tmp/.gitkeep

# IDEs e Editores de Código (VS Code, Eclipse, NetBeans, IntelliJ)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
nbproject/
nb-configuration.xml

# Ficheiros de Sistema Operativo
.DS_Store
Thumbs.db
desktop.ini
*.tmp
